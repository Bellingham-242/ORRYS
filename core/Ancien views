@login_required
def ajouter_utilisateur(request):
    if request.method == 'POST':
        # Récupération des données
        username = request.POST.get('username')
        email = request.POST.get('email')
        password = request.POST.get('password')
        password_confirm = request.POST.get('password_confirm')
        role = request.POST.get('role')
        phone = request.POST.get('phone')
        photo = request.FILES.get('photo')

        # Validation basique des mots de passe
        if password != password_confirm:
            messages.error(request, "Les mots de passe ne correspondent pas.")
            return render(request, 'dashboards/create_user.html')

        try:
            # On utilise create_user pour le hachage automatique du mot de passe
            # On ne sauvegarde pas tout de suite pour passer les champs custom
            user = User(
                username=username,
                email=email,
                role=role,
                phone=phone,
                photo=photo,
                is_approved=False # Par défaut selon ton modèle
            )
            user.set_password(password)
            
            # La méthode save() de ton modèle appelle full_clean() 
            # donc les quotas seront vérifiés ici.
            user.save()

            messages.success(request, f"Compte {role} créé pour {username}. En attente d'approbation.")
            return redirect('admin_dashboard')

        except ValidationError as e:
            # Capture l'erreur de quota du modèle (ex: "Quota atteint : Maximum 3 Administrateurs.")
            messages.error(request, e.messages[0])
        except Exception as e:
            messages.error(request, f"Erreur système : {e}")

    return render(request, 'dashboards/create_user.html')


